<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ sop.title }} — SOP v{{ sop.version }}</title>
<style>
  :root { --ink:#1b1f24; --muted:#5b6470; --line:#d9dee4; --accent:#1f5fae; --ok:#1e7a46; --warn:#a15c00; --bad:#b42318; --bg:#ffffff; --card:#f7f9fb; }
  * { box-sizing: border-box; }
  body { font: 14px/1.45 system-ui, -apple-system, "Segoe UI", sans-serif; color: var(--ink); background: var(--bg); margin: 0 auto; max-width: 980px; padding: 24px 16px 64px; }
  header { border-bottom: 2px solid var(--ink); padding-bottom: 12px; margin-bottom: 20px; }
  h1 { font-size: 22px; margin: 0 0 4px; }
  .meta { color: var(--muted); font-size: 12px; }
  .metrics { display: flex; flex-wrap: wrap; gap: 8px; margin: 12px 0 0; }
  .metric { background: var(--card); border: 1px solid var(--line); border-radius: 6px; padding: 6px 10px; }
  .metric b { display: block; font-size: 16px; }
  .metric span { color: var(--muted); font-size: 11px; text-transform: uppercase; letter-spacing: .04em; }
  h2 { font-size: 16px; text-transform: uppercase; letter-spacing: .06em; border-bottom: 1px solid var(--line); padding-bottom: 4px; margin-top: 28px; }
  .step { border: 1px solid var(--line); border-left: 4px solid var(--accent); border-radius: 6px; padding: 10px 12px; margin: 10px 0; page-break-inside: avoid; }
  .step.technique { border-left-color: var(--warn); background: #fffaf2; }
  .step-head { display: flex; justify-content: space-between; gap: 8px; align-items: baseline; }
  .action { font-weight: 600; font-size: 15px; }
  .badges { white-space: nowrap; }
  .badge { font-size: 11px; border-radius: 10px; padding: 1px 7px; border: 1px solid var(--line); margin-left: 4px; color: var(--muted); }
  .badge.ok { color: var(--ok); border-color: var(--ok); }
  .badge.bad { color: var(--bad); border-color: var(--bad); }
  .badge.warn { color: var(--warn); border-color: var(--warn); }
  dl { display: grid; grid-template-columns: 110px 1fr; gap: 2px 10px; margin: 8px 0 0; }
  dt { color: var(--muted); font-size: 12px; }
  dd { margin: 0; }
  .ref { font-size: 12px; color: var(--muted); }
  .notes, .flags { font-size: 12px; margin: 6px 0 0; padding-left: 18px; }
  .flags li { color: var(--bad); }
  .global-flags li { margin: 2px 0; }
  footer { margin-top: 32px; color: var(--muted); font-size: 11px; }
</style>
</head>
<body>
<header>
  <h1>{{ sop.title }}</h1>
  <div class="meta">SOP v{{ sop.version }} · {{ sop.created.strftime("%Y-%m-%d %H:%M UTC") }} · {{ sop.runs|length }} run{{ "s" if sop.runs|length != 1 }} · writer: {{ sop.writer }}</div>
  <div class="metrics">
    <div class="metric"><b>{{ "%.0f"|format(sop.metrics.get("verifier_pass_rate", 0) * 100) }}%</b><span>verified</span></div>
    <div class="metric"><b>{{ "%.0f"|format(sop.metrics.get("grounded_pct", 0) * 100) }}%</b><span>cited</span></div>
    <div class="metric"><b>{{ "%.2f"|format(sop.metrics.get("band_width_ratio", 1)) }}</b><span>band width vs default</span></div>
    <div class="metric"><b>{{ "%.2f"|format(sop.metrics.get("mean_confidence", 0)) }}</b><span>mean confidence</span></div>
    <div class="metric"><b>{{ sop.metrics.get("mandatory_steps", 0)|int }} / {{ sop.metrics.get("technique_steps", 0)|int }}</b><span>mandatory / technique</span></div>
  </div>
</header>

{% for phase in sop.phases %}{% set steps = sop.steps_in(phase) %}{% if steps %}
<h2>{{ phase }}</h2>
{% for s in steps %}
<div class="step{% if not s.mandatory %} technique{% endif %}" id="{{ s.id }}">
  <div class="step-head">
    <div class="action">{{ s.action }}</div>
    <div class="badges">
      {% if not s.mandatory %}<span class="badge warn">technique {{ s.seen_in }}/{{ s.run_count }}</span>{% endif %}
      <span class="badge">conf {{ "%.2f"|format(s.confidence) }}</span>
      {% if s.verified %}<span class="badge ok">verified</span>{% else %}<span class="badge bad">unverified</span>{% endif %}
      {% if s.edited %}<span class="badge">edited</span>{% endif %}
    </div>
  </div>
  <dl>
    {% if s.trigger %}<dt>Trigger</dt><dd>{{ s.trigger }}</dd>{% endif %}
    {% if s.intent %}<dt>Intent</dt><dd>{{ s.intent }}</dd>{% endif %}
    {% if s.expected %}<dt>Expected</dt><dd>{{ s.expected }}</dd>{% endif %}
    {% if s.tolerance %}<dt>Tolerance</dt><dd>{{ s.tolerance }}</dd>{% endif %}
    {% if s.reference %}<dt>Reference</dt><dd class="ref">{{ s.reference.doc }}{% if s.reference.section %} — {{ s.reference.section }}{% endif %}</dd>{% endif %}
  </dl>
  {% if s.technique_notes %}<ul class="notes">{% for n in s.technique_notes %}<li>{{ n }}</li>{% endfor %}</ul>{% endif %}
  {% if s.flags %}<ul class="flags">{% for f in s.flags %}<li>{{ f }}</li>{% endfor %}</ul>{% endif %}
</div>
{% endfor %}{% endif %}{% endfor %}

{% if sop.flags %}
<h2>Review flags</h2>
<ul class="global-flags">{% for f in sop.flags %}<li><b>{{ f.kind }}</b>{% if f.run_id %} [{{ f.run_id }}]{% endif %}: {{ f.message }}</li>{% endfor %}</ul>
{% endif %}

<footer>Generated by Sim-to-SOP from simulator telemetry. Every number is checked against recorded data; tolerance bands come from {{ sop.runs|length }} run{{ "s" if sop.runs|length != 1 }}. Not a certified document.</footer>
</body>
</html>
