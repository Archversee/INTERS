# Copy to .env and edit. Real environment variables override this file.

# --- LLM provider: ollama | openai | anthropic | none ---
SIM2SOP_LLM_PROVIDER=ollama
# SIM2SOP_MODEL=qwen2.5:7b-instruct

# Hosted API instead of Ollama, e.g.:
# SIM2SOP_LLM_PROVIDER=openai
# SIM2SOP_MODEL=gpt-4o-mini
# SIM2SOP_API_KEY=sk-...
# SIM2SOP_LLM_BASE_URL=https://api.openai.com/v1   # or OpenRouter / Groq / vLLM / LM Studio URL
#
# SIM2SOP_LLM_PROVIDER=anthropic
# SIM2SOP_MODEL=claude-sonnet-5-5
# SIM2SOP_API_KEY=sk-ant-...

# --- Reference RAG embeddings: tfidf (no model) | ollama (nomic-embed-text) ---
SIM2SOP_EMBED_PROVIDER=tfidf
# OLLAMA_URL=http://localhost:11434
